FROM registry.sh.nextgenwaterprediction.com/infrastructure/rockylinux/rockylinux:9.3

RUN dnf install -y python pip

WORKDIR /app

COPY ./simple_server /app
COPY ./tests /app
COPY ./setup.py /app

RUN pip install --index-url ${CI_SERVER_PROTOCOL}://gitlab-ci-token:${CI_JOB_TOKEN}@${CI_SERVER_HOST}/api/v4/projects/${CI_PROJECT_ID}/packages/pypi/simple .

CMD ["simple_server"]
